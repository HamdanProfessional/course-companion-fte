# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host/database

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=course-content
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# JWT Security
# IMPORTANT: Generate a strong secret key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Application Settings
APP_NAME=Course Companion FTE
APP_VERSION=1.0.0
DEBUG=True

# Server Configuration
# IMPORTANT: Backend should run on port 3505 in production
# Change this if you need to run on a different port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3505

# CORS
# Make sure to include the backend port if you change it
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://92.113.147.250:3225","http://92.113.147.250:3505"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Phase 2: LLM Configuration (Optional)
# =============================================================================
# Set to true to enable Phase 2 hybrid LLM features
# Default: false (Phase 1 Zero-LLM mode)
ENABLE_PHASE_2_LLM=false

# LLM Provider: openai, anthropic, glm, or deepseek
LLM_PROVIDER=openai

# OpenAI Configuration (if LLM_PROVIDER=openai)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (if LLM_PROVIDER=anthropic)
# Get API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# GLM (Zhipu AI) Configuration (if LLM_PROVIDER=glm)
# Get API key from: https://open.bigmodel.cn/
GLM_API_KEY=your-glm-api-key-here
GLM_MODEL=glm-4.5-air
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# DeepSeek Configuration (if LLM_PROVIDER=deepseek)
# Get API key from: https://platform.deepseek.com/
# DeepSeek offers free tier with competitive pricing
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM Generation Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=30
